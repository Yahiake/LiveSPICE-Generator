{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Fender-5e3-TweedInteractive",
  "description": "Cathode-biased vintage tweed amplifier with interactive dual-channel volume loading and tube sag dynamics.",
  "circuit": "circuits/Fender 5e3.schx",
  "input": "audio/sample_di.wav",
  "budget": 1500,
  "duration": 2.0,
  "joint": "independent",
  "spans": "signal",
  "render": {
    "sampleRate": 48000,
    "oversample": 16,
    "iterations": 32,
    "normalize": 0.9,
    "warmup": 0.08,
    "speaker": "S1"
  },
  "sampling": {
    "gainDb": [-15.0, 6.0],
    "seed": 808
  },
  "knobs": {
    "Volume": {
      "bands": [
        { "from": 0.1, "to": 0.5, "weight": 0.5, "note": "Clean tweed sparkle to edge of breakup" },
        { "from": 0.5, "to": 1.0, "weight": 0.5, "note": "Power section compression and sag overdrive" }
      ]
    },
    "Unused": {
      "bands": [
        { "from": 0.0, "to": 1.0, "weight": 1.0, "note": "Channel 2 interactive cathode follower loading" }
      ]
    },
    "Tone": {
      "bands": [ [0.1, 0.9] ]
    }
  }
}
