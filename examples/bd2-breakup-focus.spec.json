{
  "name": "BOSSBD2BluesDriver-BreakupFocus",
  "circuit": "../LiveSPICE/BOSS BD-2 Blues Driver.schx",
  "input": "input.wav",
  "duration": 15.0,
  "render": {
    "sampleRate": 48000,
    "oversample": 2,
    "iterations": 8,
    "normalize": 0.9
  },
  "sampling": {
    "joint": "independent",
    "spans": "signal",
    "gainDb": [-18.0, 6.0],
    "seed": 42
  },
  "knobs": {
    "Gain": {
      "bands": [
        { "from": 0.0, "to": 0.2, "count": 1000, "note": "fine-grained edge-of-breakup transition" },
        { "from": 0.2, "to": 1.0, "count": 1500, "note": "medium to high overdrive saturation" }
      ]
    },
    "Level": {
      "bands": [
        { "from": 0.0, "to": 0.2, "count": 1000, "note": "low output taper" },
        { "from": 0.2, "to": 1.0, "count": 1500, "note": "unity and boost range" }
      ]
    },
    "Tone": {
      "bands": [
        { "from": 0.0, "to": 1.0, "count": 2500, "note": "full sweep coverage" }
      ]
    }
  }
}
